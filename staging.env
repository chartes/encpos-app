# URL for Elasticsearch : remote server staging (pre-prod) & production (security enabled):
ELASTICSEARCH_URL=http://elastic:${ES_PASSWORD}@127.0.0.1:9200

DOCUMENT_INDEX = 'encpos_document'
COLLECTION_INDEX = 'encpos_collection'
ALL_YEARS=1849-2025
#temporary DTS_URL (when test material is cleared, DTS_URL will be https://dev.chartes.psl.eu/dots/api/dts)
DTS_URL = https://dots.chartes.psl.eu/api/dts
METADATA_FILE_URL = https://raw.githubusercontent.com/chartes/encpos/refs/heads/master/metadata/encpos.tsv
METADATA_FILE_INDEXABLE_COLUMNS = id,author_name,author_firstname,title_rich,promotion_year,topic_notBefore,topic_notAfter,author_gender,author_is_enc_teacher

SEARCH_RESULT_PER_PAGE = 200
